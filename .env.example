# Cybernauts Integrated Platform — Unified Environment Configuration Template
# Team A (Lead Intelligence) + Team B (Conversational AI Voice Agent via Plivo)
# Copy this file to .env and configure your credentials.

# ==========================================
# 1. SERVER & NETWORKING
# ==========================================
PORT=8000
# PUBLIC_BASE_URL: Required for Plivo Webhooks and WebSockets (e.g., https://xxxx.ngrok-free.app)
# Must use https:// in production / ngrok so Plivo can dispatch XML answer webhooks and WSS media streams.
PUBLIC_BASE_URL=

# ==========================================
# 2. PLIVO TELEPHONY CONFIGURATION
# ==========================================
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=

# ==========================================
# 3. AI SERVICES (STT, LLM, TTS)
# ==========================================
# Deepgram (STT)
DEEPGRAM_API_KEY=

# Groq / OpenAI (LLM)
GROQ_API_KEY=
OPENAI_API_KEY=

# ElevenLabs / Cartesia (TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
CARTESIA_API_KEY=

# ==========================================
# 4. WEBRTC / LIVEKIT (OPTIONAL)
# ==========================================
TRANSPORT_MODE=plivo
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM=cybernauts-voice-room

# ==========================================
# 5. TEAM A: OSINT & SEARCH PROVIDERS
# ==========================================
SEARCH_PROVIDER=auto
SEARCH_MODE=semantic
ENABLE_SERPAPI=false
SERPAPI_KEY=

ENABLE_BRAVE=true
BRAVE_SEARCH_API_KEY=

ENABLE_BRIGHTDATA=false
BRIGHTDATA_KEY=
BRIGHTDATA_ZONE=serp_api1

ENABLE_GOOGLE_CSE=false
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

ENABLE_GOOGLE_HTML=false
ENABLE_PLAYWRIGHT_GOOGLE=true
ENABLE_LINKEDIN_PLAYWRIGHT=true
ENABLE_BING=true

HUNTER_ENABLED=false
HUNTER_API_KEY=

# Search Tuning & Budgets
MAX_RESULTS_PER_QUERY=10
GLOBAL_QUERY_LIMIT=50
MAX_QUERIES_BUDGET=20
MAX_TOTAL_SEARCH_BUDGET=25
MAX_DIRECT_QUERIES_BUDGET=10

# Network, Proxies & Timeouts
MAX_RETRIES=3
REQUEST_DELAY=2
REQUEST_TIMEOUT=10
CONNECT_TIMEOUT=10.0
READ_TIMEOUT=30.0
VERIFY_SSL=true

# Playwright Browser Pool
PLAYWRIGHT_POOL_SIZE=3
PLAYWRIGHT_BROWSER_RECYCLE_LIMIT=50
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_IGNORE_CERTIFICATE_ERRORS=true

# ==========================================
# 6. LOGGING & SECURITY
# ==========================================
LOG_LEVEL=INFO
LOG_DIR=logs
JWT_SECRET_KEY=change-this-to-a-secure-random-32-byte-secret-in-production
