# Cybernauts Integrated Platform — Unified Environment Configuration Template
# Team A (Lead Intelligence) + Team B (Conversational AI Voice Agent via Plivo / LiveKit)
# Copy this file to .env and configure your credentials.

# ==========================================
# 1. SERVER & NETWORKING
# ==========================================
PORT=8000
# PUBLIC_BASE_URL / SERVER_BASE_URL: Required for Plivo Webhooks and WebSockets (e.g., https://xxxx.ngrok-free.app)
# Must use https:// so Plivo can dispatch XML answer webhooks and WSS media streams.
PUBLIC_BASE_URL=https://your-domain.ngrok-free.app
SERVER_BASE_URL=https://your-domain.ngrok-free.app

# ==========================================
# 2. ACTIVE TRANSPORT MODE
# ==========================================
# Options: "plivo" (Telephony via Plivo) | "twilio" (Telephony via Twilio) | "livekit" (WebRTC)
TRANSPORT_MODE=plivo

# ==========================================
# 3. TELEPHONY CREDENTIALS
# ==========================================
# Plivo (Primary Telephony)
PLIVO_AUTH_ID=MAYJXXXXXXXXXXXXXXXXXX
PLIVO_AUTH_TOKEN=your_plivo_auth_token_here
PLIVO_PHONE_NUMBER=+1234567890

# Twilio (Fallback / Alternate)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ==========================================
# 4. WEBRTC / LIVEKIT (OPTIONAL)
# ==========================================
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_ROOM=cybernauts-voice-room

# ==========================================
# 5. AI SERVICES (STT, LLM, TTS)
# ==========================================
# Speech-to-Text (STT)
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=your_deepgram_api_key

# LLM (Brain)
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Text-to-Speech (TTS)
TTS_PROVIDER=elevenlabs
ELEVEN_LABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVEN_LABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_turbo_v2_5
CARTESIA_API_KEY=

# ==========================================
# 6. DATABASE & ENVIRONMENT
# ==========================================
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/voice_db
ENVIRONMENT=development

# ==========================================
# 7. TEAM A: OSINT & SEARCH PROVIDERS
# ==========================================
SEARCH_PROVIDER=auto
SEARCH_MODE=semantic
ENABLE_SERPAPI=false
SERPAPI_KEY=

ENABLE_BRAVE=true
BRAVE_SEARCH_API_KEY=

ENABLE_BRIGHTDATA=false
BRIGHTDATA_KEY=
BRIGHTDATA_ZONE=serp_api1

ENABLE_GOOGLE_CSE=false
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

ENABLE_GOOGLE_HTML=false
ENABLE_PLAYWRIGHT_GOOGLE=true
ENABLE_LINKEDIN_PLAYWRIGHT=true
ENABLE_BING=true

HUNTER_ENABLED=false
HUNTER_API_KEY=

# Search Tuning & Budgets
MAX_RESULTS_PER_QUERY=10
GLOBAL_QUERY_LIMIT=50
MAX_QUERIES_BUDGET=20
MAX_TOTAL_SEARCH_BUDGET=25
MAX_DIRECT_QUERIES_BUDGET=10

# Network, Proxies & Timeouts
MAX_RETRIES=3
REQUEST_DELAY=2
REQUEST_TIMEOUT=10
CONNECT_TIMEOUT=10.0
READ_TIMEOUT=30.0
VERIFY_SSL=true

# Playwright Browser Pool
PLAYWRIGHT_POOL_SIZE=3
PLAYWRIGHT_BROWSER_RECYCLE_LIMIT=50
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_IGNORE_CERTIFICATE_ERRORS=true

# ==========================================
# 8. LOGGING & SECURITY
# ==========================================
LOG_LEVEL=INFO
LOG_DIR=logs
JWT_SECRET_KEY=change-this-to-a-secure-random-32-byte-secret-in-production
